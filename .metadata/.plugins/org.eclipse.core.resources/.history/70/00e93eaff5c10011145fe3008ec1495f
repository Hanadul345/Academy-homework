package com.kh.conditon;

import java.util.Scanner;

public class ConditionSwitch {

	public void method0() {
		// 스위치문 공부하기!!
		Scanner sc = new Scanner(System.in);
		System.out.print("몇 층 가시나요? (B1 / B2 / B3) > ");
		String Floor = sc.nextLine();
		
		switch(Floor) {
		case "B1" : System.out.println("지하 1층입니다");break;
		case "B2" : System.out.println("지하 2층입니다");break;
		case "B3" : System.out.println("지하 3층입니다");break;
		// switch 변수선언 // Floor 변수명 및 값 // ex. B2라 가정했을 때
		// -> 변수값을 확인하기 시작 14행... 15행. 여기서 15행에서 case가 동등비교를 통해 확인 되었을 때
		// break가 작동하며, Scope가 종료됨.
		}
		/* switch에 대한 표현식 개념
		 * switch(case문에 기술할 동등비교 대상) {
		 * case 정수, 실수, 문자, 문자열 : 실행할 코드;
		 * [동등비교]가 필요한 상황에서 깔끔한 코드값으로 정리하고 싶을 때
		 */
	}
	public void method1() {
		Scanner sc = new Scanner(System.in);
		System.out.print("메뉴 번호를 입력하시오. > ");
		int menuNo = sc.nextInt();
		/*
		 * 희망편..
		 * 1번 메뉴는 1,000원 2번 메뉴는 500원 3번 메뉴는 4,000원 4번 메뉴 1,000원 가
		String price = menuNo == 1? 1000
				  : menuNo == 2? 500
				  : menuNo == 3? 400
		*/
		// 모던 스위치
		int price = switch(menuNo) {
		case 1, 4 -> 1000;
		case 2 -> 500;
		case 3 -> 4000;
		default -> 0;
		};
		System.out.println(menuNo + "번 메뉴는" + price + "원 입니다.");
	}
	
	
}
