	public void checkId() {
		System.out.println("회원가입 서비스입니다");
		Scanner sc = new Scanner(System.in);
		//사용자에게 아이디 입력 받기
		// 입력된 아이디 10자 넘으면 다시 입력
		// 입력한 아이디 10자 안넘으면 다음 파트
		
		while(true) {
			System.out.println("아이디를 입력하시오(10글자를 넘기지 말아주세요) > ");
			String userId = sc.nextLine();
			if(userId.length() <= 10) {
				//1. 값: 사용자가 입력할 문자열의 길이
				//2. 대소비교 : 10 아래로
				System.out.println("다시 입력해 10자 미만으로 십탱아");
				continue;
			}
			System.out.println("비밀번호 입력하시오");
		
	}

