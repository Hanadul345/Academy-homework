	public void method6() {
		//복사 (얕은, 깊은)
		
		int[] origin = {1,2,3};
		System.out.println(Arrays.toString(origin));
		//int[] origin = new int[3]
		//int[0] origin = 1;
		//int[1] origin = 2;
		//int[2] origin = 3;
		
		int[] copy = origin;
		System.out.println(Arrays.toString(copy));
		
		origin[2] = 33;
		System.out.println(Arrays.toString(origin));
		System.out.println(Arrays.toString(copy));
		// 이러한 일련의 과정을 얕은 복사.		
	}
	public void method7() {
		int[] origin = {1,2,3};
		int[] copy = new int[6];
		/*
		copy[0] = origin[0];
		copy[1] = origin[1];
		copy[2] = origin[2];
		*/
		for(int i=0; i < origin.length; i++) {
			copy[i] = origin[i];
		}
		System.out.println(Arrays.toString(copy));
		int[] copy2 = new int[10];
		// Class / Interface == 네임 컨벤션 == 첫글자가 대문자
		System.arraycopy(origin,  0, copy2,  0,  3);
		System.out.println(Arrays.toString(copy2));
		// arraycopy(원본배열, 원본 배열에서 복사를 시작할 인덱스 번호, 복사본 배열
		//			 복사본에서 복사될 인덱스, 복사할 요소 갯수)
		int[] copy3 = Arrays.copyOf(origin,  15);
		System.out.println(Arrays.toString(copy3));
		
		}
	}
