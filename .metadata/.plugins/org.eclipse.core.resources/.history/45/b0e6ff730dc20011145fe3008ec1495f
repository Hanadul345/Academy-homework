public class LoopFor { //반복문
	
	public void method0() {
		//System.out.println("주목!!!!!");
		for(
			int i = 0;
				i < 3;
				i++
				) {
			System.out.println(i + 1 + "번 반복");
		}	
	}
	/* for문에 대해서
	 * for() {}
	 * 
	 *  초기식; 조건식; 증감식 세가지요소로 구성
	 *  for(int i=0; i<5; i++){
	 *  int i=0; 은 반복 돌릴 코드
	 *  }
	 *  ★ 초기식 : 반복문 시작 시 "초기에 단 한번만 실행" 될 구문
	 *  		  반복 시작할 때 필요한 변수를 선언, 초기화 하는 구문(제어변수) => int i = 0
	 *  ★ 조건식 : "반복문이 실행될 조건" 을 작성하는 구문
	 *  		 조건식 결과에 따라 (true, false) Scope 내부로 진입 또는 빠져나감(i<5)
	 *  ★ 증감식 : "반복문을 제어하는 제어변수에 대입된 값"을 증감하는 구문
	 *  		  보통 초기식에서 선언된 변수를 토대로 증감식 작성, 보편적으로 증감 연산자사용
	 */
	public void method1() {
		// 개 단순하게 1.2.3 을 보여주고 싶을때
		// System.out.println("1\n2\n3")
		for(int i=1; i <= 3; i++) {
			//for 이란 변수선언 공간을 할당 받고
			// 1. 초기식 : 그 안에 int형 변수선언 i를 할당 또 받고, 그 값은 1
			// 2. 조건식 : 1부터 시작해서 조건문을 거치고 조건문에서 true 값을 받을 경우
			// 3. System : 으로 넘어가서 출력값 i를 만드는데
			// 4. 증감문 ++ 를 받아 i에 1을 추가한 값을 출력하는 방식
			// 5. 증감문을 마쳤을 때 다시 2번으로, 3번으로 진행
			// 6. 변수선언을 할당 받은 'i'가 2번 조건문에서 벗어난 경우 Scope 밖으로 스킵
			System.out.println(i);
		}
		/*for(int k = 0; k < 10; 1 += 2;) {
			System.out.println(k);
		}
		*/
	}
